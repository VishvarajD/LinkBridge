
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  
  "rewrites": [
    {
      "source": "/",
      "destination": "/Home.html"
    },
    {
      "source": "/linkbridge",
      "destination": "/index.html"
    },
    {
      "source": "/linkbridge/:path*",
      "destination": "/index.html"
    }
  ]
}
